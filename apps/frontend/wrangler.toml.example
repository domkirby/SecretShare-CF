name = "secretsharecf-frontend"
compatibility_date = "2026-07-23"

# VITE_* build variables are set via the Cloudflare dashboard (project → Settings →
# Variables and Secrets → Build variables), not here — see DEPLOYMENT.md §2.5. This
# project has no `main` Worker entry, so a [vars] block here would never be read at
# runtime; Vite only ever sees these values at build time.

[assets]
directory = "./dist"
not_found_handling = "single-page-application"
