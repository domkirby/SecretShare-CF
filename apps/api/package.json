{
  "name": "@secretshare/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create secretshare",
    "db:migrate:local": "wrangler d1 execute secretshare --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute secretshare --remote --file=./schema.sql",
    "db:query:local": "wrangler d1 execute secretshare --local --command"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.113.0"
  },
  "dependencies": {
    "hono": "^4.6.0"
  }
}
